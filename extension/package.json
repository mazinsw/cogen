{
  "name": "cogen-templates",
  "displayName": "Cogen Templates",
  "description": "Syntax highlighting, diagnostics, navigation, completion and preview for cogen templates (*.cgn)",
  "version": "0.1.0",
  "publisher": "mazinsw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazinsw/cogen.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "gen": "node scripts/gen-languages.mjs && node scripts/gen-vocabulary.mjs",
    "build": "npm run gen && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../node_modules/jest/bin/jest.js -c jest.config.json",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "test:integration": "npm run build && node test/integration/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "cogen.preview",
        "title": "Preview for Table…",
        "category": "Cogen",
        "icon": "$(open-preview)"
      },
      {
        "command": "cogen.previewRefresh",
        "title": "Refresh Preview",
        "category": "Cogen",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cogen.preview",
          "when": "resourceLangId =~ /^cogen-/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cogen.preview",
          "when": "editorLangId =~ /^cogen-/"
        },
        {
          "command": "cogen.previewRefresh",
          "when": "editorLangId =~ /^cogen-/"
        }
      ]
    },
    "configuration": {
      "title": "Cogen",
      "properties": {
        "cogen.templatePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders (relative to the workspace folder) whose files are treated as cogen templates even without the `.cgn` suffix, e.g. `scripts/template`."
        },
        "cogen.projectFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Project properties file used by the preview (`inputFile`, `templatePath`, `lang`, ...). When empty, the nearest `cogen.properties` above the template is used."
        },
        "cogen.inputFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Modeling SQL file used by the preview when no project file defines `inputFile`."
        },
        "cogen.legacy": {
          "type": "boolean",
          "default": false,
          "description": "Use legacy loops in the preview."
        }
      }
    },
    "languages": [
      {
        "id": "cogen-ts",
        "aliases": [
          "Cogen (TypeScript)"
        ],
        "extensions": [
          ".ts.cgn",
          ".mts.cgn",
          ".cts.cgn"
        ],
        "configuration": "./language-configuration/cogen-ts.json",
        "icon": {
          "light": "./images/cogen.svg",
          "dark": "./images/cogen.svg"
